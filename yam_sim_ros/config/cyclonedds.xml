<?xml version="1.0" encoding="UTF-8"?>
<!--
  CycloneDDS settings for this pixi environment (exported as CYCLONEDDS_URI by pixi.toml).

  Why: a 1280x720 rgb8 wrist-camera frame is 2.7 MB, i.e. ~300 UDP fragments. With the OS default
  UDP receive buffer (~0.75 MB on macOS) a burst of fragments overflows it, and a BEST_EFFORT
  subscriber (`ros2 topic hz`, rqt_image_view, RViz set to best effort) then drops every frame and
  sees nothing. Asking for a larger buffer fixes that. `max` is a request, not a requirement, so
  this never stops a participant from starting on a machine with a lower limit (Linux:
  net.core.rmem_max, default 208 KB -> raise it with `sudo sysctl -w net.core.rmem_max=8388608`).
-->
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain id="any">
    <Internal>
      <SocketReceiveBufferSize min="default" max="8MB"/>
    </Internal>
  </Domain>
</CycloneDDS>
