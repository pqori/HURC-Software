<?xml version="1.0" ?>
<!--
  Nav2 obstacle-avoidance demo world for the HURC rover (Gazebo Harmonic).
  Start A = (0, 0), goal B = (8, 0, yaw 0). The straight line A->B is blocked
  by box_line_1 and cyl_line_2; the clear detour runs south (y ~ -2) with
  >= 1.5 m clearance. Obstacle table: rover_sim/README.md (generated from the
  same numbers).
-->
<sdf version="1.9">
  <world name="obstacles">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <gravity>0 0 -9.8</gravity>
    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.7 0.8 0.9 1</background>
      <shadows>false</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
          <material><ambient>0.45 0.42 0.38 1</ambient><diffuse>0.45 0.42 0.38 1</diffuse><specular>0.05 0.05 0.05 1</specular></material>
        </visual>
      </link>
    </model>

    <model name="box_line_1">
      <static>true</static>
      <pose>3.0 0.3 0.4 0 0 0.0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.0 1.2 0.8</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.0 1.2 0.8</size></box></geometry>
          <material><ambient>0.8 0.3 0.2 1</ambient><diffuse>0.8 0.3 0.2 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
        </visual>
      </link>
    </model>
    <model name="cyl_line_2">
      <static>true</static>
      <pose>5.5 0.0 0.5 0 0 0.0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.5</radius><length>1.0</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.5</radius><length>1.0</length></cylinder></geometry>
          <material><ambient>0.2 0.4 0.8 1</ambient><diffuse>0.2 0.4 0.8 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
        </visual>
      </link>
    </model>
    <model name="wall_north">
      <static>true</static>
      <pose>4.25 2.0 0.4 0 0 0.0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>3.0 0.2 0.8</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>3.0 0.2 0.8</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
        </visual>
      </link>
    </model>
    <model name="box_sw">
      <static>true</static>
      <pose>2.0 -4.3 0.3 0 0 0.0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.8 0.8 0.6</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.8 0.8 0.6</size></box></geometry>
          <material><ambient>0.8 0.6 0.2 1</ambient><diffuse>0.8 0.6 0.2 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
        </visual>
      </link>
    </model>
    <model name="cyl_se">
      <static>true</static>
      <pose>6.5 -4.2 0.35 0 0 0.0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.3</radius><length>0.7</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.3</radius><length>0.7</length></cylinder></geometry>
          <material><ambient>0.3 0.7 0.3 1</ambient><diffuse>0.3 0.7 0.3 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
        </visual>
      </link>
    </model>
    <model name="box_ne">
      <static>true</static>
      <pose>7.0 3.0 0.6 0 0 0.5</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.0 1.0 1.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.0 1.0 1.2</size></box></geometry>
          <material><ambient>0.7 0.2 0.6 1</ambient><diffuse>0.7 0.2 0.6 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
        </visual>
      </link>
    </model>
    <model name="cyl_nw">
      <static>true</static>
      <pose>1.0 3.0 0.45 0 0 0.0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.4</radius><length>0.9</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.4</radius><length>0.9</length></cylinder></geometry>
          <material><ambient>0.2 0.7 0.7 1</ambient><diffuse>0.2 0.7 0.7 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
        </visual>
      </link>
    </model>
    <model name="box_far_se">
      <static>true</static>
      <pose>9.5 -2.5 0.25 0 0 0.3</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.6 0.6 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.6 0.6 0.5</size></box></geometry>
          <material><ambient>0.9 0.8 0.3 1</ambient><diffuse>0.9 0.8 0.3 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
        </visual>
      </link>
    </model>
    <model name="box_behind">
      <static>true</static>
      <pose>-2.5 1.5 0.5 0 0 0.0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.8 0.8 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.8 0.8 1.0</size></box></geometry>
          <material><ambient>0.5 0.3 0.1 1</ambient><diffuse>0.5 0.3 0.1 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
        </visual>
      </link>
    </model>
    <model name="cyl_far_ne">
      <static>true</static>
      <pose>10.0 2.0 0.3 0 0 0.0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.25</radius><length>0.6</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.25</radius><length>0.6</length></cylinder></geometry>
          <material><ambient>0.9 0.4 0.4 1</ambient><diffuse>0.9 0.4 0.4 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
